<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="CENTER"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.MainController">

    <Label text="Введите ваше имя:"/>

    <TextField fx:id="nameField" promptText="Ваше имя..."/>

    <Button text="Нажми меня!" onAction="#onButtonClick"/>

    <Label fx:id="welcomeLabel" text="Здесь будет приветствие"/>

</VBox>